# Normalize line endings: store LF in the repo, checkout native
* text=auto eol=lf

# Windows-specific
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.step binary
*.stp binary
*.stl binary
*.dxf binary
*.sldprt binary
*.sldasm binary
